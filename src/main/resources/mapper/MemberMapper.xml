<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ans.antech.mapper.MemberMapper">

  <!-- 회원 추가 -->
  <insert id="insertMember" parameterType="com.ans.antech.model.Member">
        INSERT INTO ANS_MEMBER (ID, PW, EMAIL, PROFILE_IMG, CREATE_DT)
        VALUES (#{id}, #{pw}, #{email}, 'default.png', NOW())
  </insert>

  <!-- ID로 회원 조회 -->
  <select id="selectMemberById" parameterType="string" resultType="com.ans.antech.model.Member">
        SELECT *
        FROM ANS_MEMBER
        WHERE ID = #{id}
  </select>

  <!-- 모든 회원 조회 -->
  <select id="selectAllMembers" resultType="com.ans.antech.model.Member">
        SELECT ID, PW, EMAIL, PROFILE_IMG
        FROM ANS_MEMBER
  </select>

  <!-- 로그인 id,pw 조회 -->
  <select id="selectMemberByIdAndPw" parameterType="map" resultType="Member">
    SELECT *
    FROM ANS_MEMBER
    WHERE ID = #{id} AND PW = #{pw}
  </select>

  <!-- 아이디찾기 이메일로 id 조회-->
  <select id="selectMemberByEmail" resultType="com.ans.antech.model.Member">
    SELECT *
    FROM ANS_MEMBER
    WHERE EMAIL = #{email}
  </select>

  <!-- 비밀번호찾기 - id와 email로 사용자 조회-->
  <select id="findMemberByIdAndEmail" resultType="Member">
  SELECT * FROM ANS_MEMBER WHERE ID = #{id} AND EMAIL = #{email}
  </select>

  <!-- 비밀번호 찾기 - 비밀번호 업데이트-->
  <update id="updatePassword">
  UPDATE ANS_MEMBER SET PW = #{newPassword} WHERE ID = #{id}
  </update>

  <!-- 프로필 이미지 업데이트-->
  <update id="profileUpdate">
    UPDATE ANS_MEMBER SET PROFILE_IMG = #{profileImage} WHERE ID = #{id}
  </update>

</mapper>