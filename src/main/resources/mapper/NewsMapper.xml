<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ans.antech.mapper.NewsMapper">

<!-- 주요 뉴스 최신순 6개 조회하기-->  
  <select id="selectTitle" resultType = "string">
      SELECT TITLE 
      FROM ANS_MAIN_NEWS 
      ORDER BY DT DESC 
      LIMIT 6
  </select>

  <select id="selectBNewsTitle" resultType="string">
    SELECT TITLE
    FROM ANS_BREAKING_NEWS
    ORDER BY DT DESC
    LIMIT 6
  </select>

</mapper>
