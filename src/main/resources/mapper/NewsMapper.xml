<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ans.antech.mapper.NewsMapper">

    <!-- 주요 뉴스 최신순 6개 조회하기-->
    <select id="selectTitle" resultType = "string">
      SELECT TITLE 
      FROM ANS_MAIN_NEWS 
      ORDER BY DT DESC 
      LIMIT 6
    </select>

    <select id="selectBNewsTitle" resultType="string">
    SELECT TITLE
    FROM ANS_BREAKING_NEWS
    ORDER BY DT DESC
    LIMIT 6
    </select>
    <!-- 주요 뉴스 -->
    <select id="countNews" resultType="int">
        SELECT COUNT(*) FROM ANS_MAIN_NEWS
    </select>

    <select id="findNewsByPage" resultType="com.ans.antech.model.News">
        SELECT TITLE, PRESS, IMG_URL1, URL
        FROM ANS_MAIN_NEWS 
        ORDER BY DT DESC 
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <!-- 검색된 뉴스 개수 조회 -->
    <select id="countSearchNews" resultType="int">
        SELECT COUNT(*) FROM (
            SELECT TITLE FROM ANS_BREAKING_NEWS WHERE TITLE LIKE CONCAT('%', #{keyword}, '%') 
            UNION 
            SELECT TITLE FROM ANS_MAIN_NEWS WHERE TITLE LIKE CONCAT('%', #{keyword}, '%')
        ) AS search_results
    </select>

    <!-- 페이징 적용하여 뉴스 검색 -->
    <select id="searchNewsWithPagination" resultType="com.ans.antech.model.News">
        SELECT * FROM (
            SELECT * FROM ANS_BREAKING_NEWS WHERE TITLE LIKE CONCAT('%', #{keyword}, '%') 
            UNION 
            SELECT * FROM ANS_MAIN_NEWS WHERE TITLE LIKE CONCAT('%', #{keyword}, '%')
        ) AS search_results 
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <!-- 속보 뉴스 -->
    <select id="countBNews" resultType="int">
        SELECT COUNT(*) FROM ANS_BREAKING_NEWS
    </select>

    <select id="findBNewsByPage" resultType="com.ans.antech.model.News">
        SELECT TITLE, PRESS, IMG_URL1, URL
        FROM ANS_BREAKING_NEWS 
        ORDER BY DT DESC 
        LIMIT #{pageSize} OFFSET #{offset}
    </select>


